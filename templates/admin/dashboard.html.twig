{% extends 'admin/layout.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<h1 class="text-2xl font-semibold mb-6 fg-1 tracking-title">Dashboard</h1>

<div class="grid grid-cols-3 gap-6 mb-8">
    <a href="{{ path('app_admin_users') }}" class="card hover:border-[var(--border-default)] transition-colors" style="text-decoration: none">
        <p class="text-4xl font-black fg-accent">{{ total_users }}</p>
        <p class="mt-1 font-medium fg-3">Utilisateurs</p>
        <p class="text-sm mt-2 fg-accent">Gérer →</p>
    </a>
    <a href="{{ path('app_admin_events') }}" class="card hover:border-[var(--border-default)] transition-colors" style="text-decoration: none">
        <p class="text-4xl font-black fg-accent">{{ total_events }}</p>
        <p class="mt-1 font-medium fg-3">Événements</p>
        <p class="text-sm mt-2 fg-accent">Gérer →</p>
    </a>
    <a href="{{ path('app_admin_venues') }}" class="card hover:border-[var(--border-default)] transition-colors" style="text-decoration: none">
        <p class="text-4xl font-black fg-accent">{{ total_venues }}</p>
        <p class="mt-1 font-medium fg-3">Lieux</p>
        <p class="text-sm mt-2 fg-accent">Gérer →</p>
    </a>
</div>

<div class="card">
    <h2 class="font-medium mb-4 fg-1">Accès rapides</h2>
    <div class="flex flex-wrap gap-3">
        <a href="{{ path('app_admin_audit') }}" class="px-4 py-2 rounded-xl text-sm font-medium transition-colors sf-2 fg-2">
            📋 Journal d'audit
        </a>
        <a href="{{ path('app_home') }}" target="_blank" class="px-4 py-2 rounded-xl text-sm font-medium transition-colors sf-2 fg-2">
            🔗 Voir l'application
        </a>
    </div>
</div>
{% endblock %}
