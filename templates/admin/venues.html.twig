{% extends 'admin/layout.html.twig' %}

{% import 'components/_macros.html.twig' as m %}
{% block title %}Lieux{% endblock %}

{% block body %}
<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold fg-1 tracking-title">Lieux</h1>
    <form method="get" class="flex gap-2">
        <input type="search" name="q" value="{{ q }}"
               class="input-field w-64"
               placeholder="Nom, ville...">
        <button class="btn-primary px-4 py-2">Chercher</button>
    </form>
</div>

<div class="rounded-2xl overflow-hidden sf-1-bordered">
    <table class="w-full text-sm">
        <thead class="sf-2 fg-4">
            <tr>
                <th class="px-5 py-3 text-left text-xs uppercase tracking-wide">Salle / Stade</th>
                <th class="px-5 py-3"></th>
            </tr>
        </thead>
        <tbody>
            {% for venue in venues %}
            <tr class="bt-subtle">
                <td class="px-5 py-3 font-medium fg-1">{{ venue.name }}</td>
                <td class="px-5 py-3 text-right">
                    <div class="flex items-center justify-end gap-3">
                        <a href="{{ path('app_admin_venue_edit', {id: venue.id}) }}"
                           class="text-xs font-medium fg-info">Éditer</a>
                        <form method="post" action="{{ path('app_admin_venue_delete', {id: venue.id}) }}"
                              data-controller="confirm" data-action="submit->confirm#check" data-confirm-title-value="Supprimer le lieu {{ venue.name|e('html_attr') }} ?" data-confirm-label-value="Supprimer">
                            <button class="text-xs fg-negative">Supprimer</button>
                        </form>
                    </div>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="2" class="px-5 py-10 text-center fg-4">
                    {% if q %}Aucun lieu trouvé pour "{{ q }}"{% else %}Aucun lieu enregistré{% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{{ m.pagination('app_admin_venues', {}, page, total_pages) }}
{% endblock %}
