{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as m %}

{% block title %}Inviter {{ friend_user.displayName }} — IWasThere{% endblock %}

{% block body %}
<div class="px-4 py-5">

    {# Back button #}
    {{ m.back_button(path('app_profile_view', {username: friend_user.username})) }}

    {# Header #}
    <div class="flex items-center gap-4 mt-4 mb-5">
        {{ m.avatar(friend_user, 'lg') }}
        <div class="flex-1">
            <h1 class="text-xl font-semibold fg-1">Inviter {{ friend_user.displayName }}</h1>
            <p class="text-sm fg-3">Coche les événements que vous avez vécus ensemble</p>
        </div>
    </div>

    {% if participations|length == 0 %}
        <div class="card text-center py-12">
            <p class="text-4xl mb-2">🎉</p>
            <p class="font-medium fg-1">Rien à inviter</p>
            <p class="text-sm mt-1 fg-3">
                {{ friend_user.displayName }} est déjà associé à tous tes événements.
            </p>
        </div>
    {% else %}
        <form method="post" id="invite-events-form" data-controller="invite-select">

            {# Select all #}
            <label class="card flex items-center gap-3 mb-3 cursor-pointer select-none">
                <input type="checkbox" id="invite-select-all" data-invite-select-target="all" data-action="change->invite-select#toggleAll" class="w-5 h-5 rounded accent-[var(--positive)]">
                <span class="font-medium text-sm fg-1">Tout sélectionner</span>
                <span class="ml-auto text-xs fg-4" id="invite-count" data-invite-select-target="count">0 / {{ participations|length }}</span>
            </label>

            <div class="space-y-3 mb-40">
                {% for p in participations %}
                <label class="card flex items-center gap-3 cursor-pointer select-none">
                    <input type="checkbox" name="participations[]" value="{{ p.id }}"
                           class="invite-event-checkbox w-5 h-5 rounded flex-shrink-0 accent-[var(--positive)]">
                    {{ m.event_thumb(p.event, 'lg') }}
                    <div class="flex-1 min-w-0">
                        <p class="font-medium text-sm truncate fg-1">
                            {{ p.event.artistName ?? p.event.tournamentName ?? 'Événement' }}
                        </p>
                        <p class="text-xs fg-4">{{ p.event.date|date('d/m/Y') }}{% if p.event.venue %} · {{ p.event.venue.name }}{% endif %}</p>
                    </div>
                </label>
                {% endfor %}
            </div>

            <div class="fixed left-0 right-0 z-40 px-4 pt-3 pb-3" style="bottom: calc(4rem + min(env(safe-area-inset-bottom, 0px), 12px)); background: var(--bg-1); border-top: 1px solid var(--border-subtle)">
                <button type="submit" id="invite-submit" data-invite-select-target="submit" class="btn-primary w-full py-3" disabled>
                    Inviter aux événements sélectionnés
                </button>
            </div>

        </form>


    {% endif %}

</div>
{% endblock %}
